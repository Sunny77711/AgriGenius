# Copy this file to .env and add your own API key.
# Never commit .env or keys.env to GitHub.

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AGRI_QWEN_MODEL=qwen/qwen3.8-27b
AGRI_GROQ_MODEL=openai/gpt-oss-20b
AGRI_GROQ_LARGE_MODEL=openai/gpt-oss-120b
AGRI_EVAL_JUDGE_MODEL=gemini-3.5-flash-lite
# Optional: comma-separated frontend origins for deployed environments.
# AGRI_CORS_ORIGINS=https://your-frontend.example

# Neon PostgreSQL Database Connection URL
# Paste your Neon connection string here:
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Email Delivery Configuration (For real OTP and Welcome emails in inbox)
# Using Gmail SMTP (Free):
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate a 16-character App Password for 'AgriGenius'
# 3. Paste your Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=AgriGenius

# Google OAuth 2.0 Web Client Configuration
# 1. In Google Cloud Console -> APIs & Services / Google Auth Platform -> Clients
# 2. Add 'http://localhost:5173' to Authorized JavaScript origins
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
